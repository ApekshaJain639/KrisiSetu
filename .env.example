# KRISISETU Environment Variables Configuration

# Database & Redis
DATABASE_URL=postgresql+asyncpg://krisisetu_admin:secret_password@localhost:5432/krisisetu_db
REDIS_URL=redis://localhost:6379/0

# AI & Multimodal Model Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Speech & Vernacular (Optional / Future)
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Meta WhatsApp Cloud API (Accountability Engine)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=krisisetu_webhook_secret

# External APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
AGMARKNET_API_ENDPOINT=https://api.data.gov.in/resource
